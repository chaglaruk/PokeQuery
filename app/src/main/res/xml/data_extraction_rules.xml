<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for API 31+ (Android 12+).
   allowBackup="false" disables backup at the application level; these rules mirror
   the pre-API-31 backup contract as defense in depth and exclude every app-owned
   storage domain from both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
